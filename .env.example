# ─────────────────────────────────────────────────────────────────────────────
# revault — Next.js site (repo root) + API (server/). Copy to .env for
# docker compose; for local dev the site reads .env.local and the server
# reads server/.env (see server/.env.example).
# ─────────────────────────────────────────────────────────────────────────────

# --- Site (NEXT_PUBLIC_* is baked in at build time) ---
# API origin. Leave EMPTY in dev: the browser then calls same-origin /api/*
# and next.config.ts rewrites it to the local server on :4000.
NEXT_PUBLIC_API_URL=
# Canonical site URL (metadata + www→apex redirect).
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# --- Server (docker compose) ---
POSTGRES_PASSWORD=change-me
ADMIN_SERVICE_TOKEN=change-me-openssl-rand-hex-32
INTAKE_EMAIL=intake@revault.nl
MAIL_FROM="Revault <noreply@revault.nl>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
