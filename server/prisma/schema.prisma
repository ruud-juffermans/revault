generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum IntakeStatus {
  NEW
  ASSESSED
  VIABLE
  NOT_VIABLE
  AGREEMENT
  RECOVERY
  CLOSED
}

model Intake {
  id             String       @id @default(cuid())
  reference      String       @unique
  name           String
  email          String
  phone          String?
  walletType     String
  walletSoftware String?
  issueType      String
  estimatedValue String?
  description    String
  locale         String
  status         IntakeStatus @default(NEW)
  notes          String?
  ip             String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
}

/// Newsletter signups from the site (footer + blog). Local only: no third-party
/// list provider. `active=false` keeps the row for history after an unsubscribe.
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  locale         String?
  source         String    @default("web")
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  unsubscribedAt DateTime?

  @@index([active, createdAt])
}

model PageView {
  id        String   @id @default(cuid())
  path      String
  locale    String?
  referrer  String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([path])
}
