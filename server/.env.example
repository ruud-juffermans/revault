# revault server — copy to server/.env for local development.
PORT=4000
DATABASE_URL=postgresql://revault:revault@localhost:5432/revault
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3001
# Bearer token for /api/revault/admin/*. Generate: openssl rand -hex 32
ADMIN_SERVICE_TOKEN=change-me
# Where new-intake notifications go. Leave SMTP_HOST empty in dev to log
# emails to stdout instead of sending them.
INTAKE_EMAIL=intake@revault.nl
MAIL_FROM="Revault <noreply@revault.nl>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Trust X-Forwarded-For from the reverse proxy (Traefik) for rate limiting.
TRUST_PROXY=0
